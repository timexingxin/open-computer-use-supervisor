#!/usr/bin/env node
// LEGACY COMPATIBILITY FALLBACK: "agy-supervisor" binary alias maintained for backward compatibility with earlier integration scripts.
import { runCli } from '../src/cli.mjs';

runCli(process.argv.slice(2)).then(code => {
  process.exit(code || 0);
}).catch(err => {
  console.error(`Fatal Error in open-computer-use-supervisor:`, err);
  process.exit(1);
});
